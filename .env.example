# Copy to .env (git-ignored) and adjust. Used by docker-compose.yml.

# Group ID that owns the Docker socket *inside the container*, so the unprivileged container user can read it.
#   Native Docker Engine (the socket belongs to the host's docker group):  getent group docker | cut -d: -f3
#   Docker Desktop for Linux (the socket appears as root:root in containers):  0
# If it is wrong, the container logs say exactly which value to use.
DOCKER_GID=999

# Access token for the web UI (>= 16 characters). Generate one with:  openssl rand -hex 24
# If left empty, a random token is generated on every start and printed in `docker compose logs`.
DI_TOKEN=

# Host port published on 127.0.0.1 (default 7780).
#DI_PORT=7780

# host:port values browsers may use (Host/Origin allow-list). Only needed if you reach the app via
# another name, e.g. through a reverse proxy: DI_ALLOWED_HOSTS=inspector.example.com
#DI_ALLOWED_HOSTS=localhost:7780
